# Copy to .env on the VPS. Never commit real secrets.

# Direct host/systemd launch binds 127.0.0.1:$PORT (default 3000). The Docker
# runbook explicitly overrides LISTEN_HOST to 0.0.0.0 inside the container;
# its published host port remains loopback-only.
PORT=3000
LISTEN_HOST=127.0.0.1

NODE_ENV=production

# Required in production. Persist this path on a volume.
DATABASE_PATH=/app/data/guest-seat.sqlite

# Waffo mode is explicit. `fixture` is offline and never reads credentials;
# `waffo-test` and `waffo-prod` fail closed unless every key below is present.
# WAFFO_MODE=fixture
# WAFFO_MODE=waffo-test
# WAFFO_MODE=waffo-prod
# WAFFO_MERCHANT_ID=
# WAFFO_PRIVATE_KEY=
# WAFFO_PRIVATE_KEY_FILE=
# WAFFO_STORE_ID=
# WAFFO_PRODUCT_ID=
# WAFFO_PUBLIC_BASE_URL=https://guest-seat.example.com
# WAFFO_API_BASE=https://api.waffo.ai
# Optional bounded checkout deadline in milliseconds (default 15000).
# WAFFO_CHECKOUT_TIMEOUT_MS=15000
# WAFFO_TEST_WEBHOOK_PUBLIC_KEY=
# WAFFO_PROD_WEBHOOK_PUBLIC_KEY=

# Legacy payment variables are intentionally ignored. Only the explicit
# WAFFO_MODE and mode-scoped WAFFO_* settings above select a provider.

# Host session. Required in production; startup fails closed when it is empty.
# It authorizes POST /host/open, POST /host/veto, and POST /host/lock.
# HOST_SESSION_SECRET=
