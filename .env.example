# Copy to .env on the VPS. Never commit real secrets.

# Process binds 0.0.0.0:$PORT (default 3000).
PORT=3000

NODE_ENV=production

# Required in production. Persist this path on a volume.
DATABASE_PATH=/app/data/guest-seat.sqlite

# Live Polar is off unless POLAR_LIVE is 1, secrets are present, and
# POLAR_FIXTURE_ONLY is not 1. POLAR_FIXTURE_ONLY=1 always wins (CI / scripts/test.sh).
# Leave live flags unset on a fresh box. Image and CI must not set POLAR_LIVE.
# POLAR_LIVE=1
# POLAR_FIXTURE_ONLY=1
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=

# Host veto / lock session. Required for POST /host/veto and POST /host/lock.
# HOST_SESSION_SECRET=
